{
  "tools": [
    {
      "name": "list_sessions",
      "description": "List active marimo sessions.\n\n        Returns a list of active sessions, each with 'name', 'path',\n        and 'session_id' fields.\n        Use the session_id with execute_code to run code in that session.\n        ",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "list_sessionsArguments"
      },
      "outputSchema": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/$defs/MarimoNotebookInfo"
            },
            "title": "Sessions",
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object",
        "$defs": {
          "MarimoNotebookInfo": {
            "properties": {
              "name": {
                "title": "Name",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "session_id": {
                "title": "Session Id",
                "type": "string"
              }
            },
            "required": [
              "name",
              "path",
              "session_id"
            ],
            "title": "MarimoNotebookInfo",
            "type": "object"
          }
        },
        "title": "ListSessionsResult"
      }
    },
    {
      "name": "execute_code",
      "description": "Execute Python code in a notebook's kernel scratchpad.\n\n        The code runs in the scratchpad — a temporary execution environment\n        that has access to all variables defined in the notebook but does not\n        affect the notebook's cells or dependency graph.\n\n        Args:\n            session_id: The session ID of the notebook (from list_sessions).\n            code: Python code to execute.\n        ",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "code"
        ],
        "type": "object",
        "title": "execute_codeArguments"
      },
      "outputSchema": {
        "properties": {
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Output"
          },
          "stdout": {
            "items": {
              "type": "string"
            },
            "title": "Stdout",
            "type": "array"
          },
          "stderr": {
            "items": {
              "type": "string"
            },
            "title": "Stderr",
            "type": "array"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "title": "Errors",
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error"
          },
          "output_mimetype": {
            "anyOf": [
              {
                "enum": [
                  "application/json",
                  "application/vnd.marimo+error",
                  "application/vnd.marimo+traceback",
                  "application/vnd.marimo+mimebundle",
                  "application/vnd.vega.v5+json",
                  "application/vnd.vegalite.v5+json",
                  "application/vnd.vega.v6+json",
                  "application/vnd.vegalite.v6+json",
                  "application/vnd.jupyter.widget-view+json",
                  "image/png",
                  "image/svg+xml",
                  "image/tiff",
                  "image/avif",
                  "image/bmp",
                  "image/gif",
                  "image/jpeg",
                  "video/mp4",
                  "video/mpeg",
                  "text/html",
                  "text/plain",
                  "text/password",
                  "text/markdown",
                  "text/latex",
                  "text/csv"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Output Mimetype"
          }
        },
        "required": [
          "success",
          "stdout",
          "stderr",
          "errors"
        ],
        "type": "object",
        "title": "CodeExecutionResult"
      }
    }
  ]
}
